# انسخ هذا الملف إلى .env واملأ القيم قبل التشغيل. لا ترفع .env الحقيقى إلى Git أبدًا.

PORT=3000

# سر تشفير الجلسات — أى نص عشوائى طويل. غيّره لقيمة فريدة خاصة بك.
SESSION_SECRET=change-this-to-a-long-random-string

# اسم المستخدم وكلمة مرور الأدمن الأولية — تُستخدم فقط عند تشغيل:
#   npm run create-admin
# بعدها يمكنك حذفهما من هذا الملف إن أردت.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
